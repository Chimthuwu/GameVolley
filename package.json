{
  "name": "gamevolley",
  "productName": "GameVolley",
  "version": "1.3.0",
  "description": "Describe a silly game idea and watch multiple AI agents design, build, review and improve a real playable game in your workspace.",
  "main": "main.js",
  "author": "Serge",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.mjs",
    "test": "node --test",
    "test:e2e": "electron scripts/e2e/e2e-history.js",
    "test:e2e:web": "electron scripts/e2e/e2e-history-web.js",
    "dist": "npm run icons && electron-builder --win --publish never",
    "site:dev": "wrangler pages dev site",
    "site:deploy": "wrangler pages deploy site --project-name=volley-prompt --branch=main --commit-dirty=true"
  },
  "build": {
    "appId": "com.serge.gamevolley",
    "productName": "GameVolley",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "src/**",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "GameVolley - Windows Setup v${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns",
      "artifactName": "VolleyPrompt - macOS v${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png",
      "artifactName": "VolleyPrompt - Linux v${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.0",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5",
    "wrangler": "^4.0.0"
  }
}
